DATABASE_URL="postgresql://todo:todo@localhost:5432/todo?schema=public"

# 開発時のみ: Codespaces 等のポート転送ホスト(カンマ区切り・正確なホスト名、ワイルドカード不可)。
# Codespaces では CODESPACE_NAME から自動導出されるため通常は不要。本番では無視される。
# DEV_ALLOWED_HOSTS=my-codespace-3000.app.github.dev
# 契約テストを実 DB でも流す場合(全削除されるため専用 DB を指定):
# TEST_DATABASE_URL="postgresql://todo:todo@localhost:5432/todo_test?schema=public"
